# Copy this to .env for local development (cloud/.env is gitignored), or set
# these as environment variables in the Vercel project's settings for a
# Vercel deployment — see dashboard/api/[...path].js and cloud/env.js.

# Required. Supabase: Project Settings -> Database -> Connection string -> URI.
# Use the session pooler host (aws-0-<region>.pooler.supabase.com:5432) —
# the direct host is often IPv6-only and unreachable from some networks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Required. The one credential the till uses to authenticate every request
# (see middleware/branch-auth.js) — a long random string, generated once and
# set the same here and in the till's cloud-sync.json. There is no pairing
# flow and nothing rotates it; if it ever needs to change (a leak, a lost
# machine), change it here and update cloud-sync.json on every till by hand.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TILL_API_KEY=

# Optional. Each concurrent server process/serverless instance holds its own
# pool up to this size — Supabase's free tier has a modest connection
# ceiling. A single persistent process (server.js on a VPS) can afford the
# default of 8; a serverless deployment, where many instances can run at
# once under load, should set this lower.
# PGPOOL_MAX=8

# Optional. Only read by server.js (the persistent-process entry point) —
# meaningless on Vercel, which supplies its own port and routing.
# PORT=4000
# MILKPOS_CLOUD_HOST=127.0.0.1
